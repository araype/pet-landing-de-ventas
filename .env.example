# Base de datos (la agrega Vercel automáticamente al conectar Postgres/Neon al proyecto)
DATABASE_URL=

# Vercel Blob (lo agrega Vercel automáticamente al conectar el store de Blob)
BLOB_READ_WRITE_TOKEN=

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Cadena secreta larga y aleatoria para firmar la sesión de admin
ADMIN_SESSION_SECRET=

# Número de WhatsApp de Aracely, sin "+" ni espacios (código de país + número)
NEXT_PUBLIC_WHATSAPP_PHONE=51920046753

# URL pública del sitio en producción (para los links de compartir)
NEXT_PUBLIC_SITE_URL=
